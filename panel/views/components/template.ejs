<!doctype html>
<html class="h-full w-full">
   <!--
     
   HEAD SECTION
     
   -->
   <head>
      <title><%= name %></title>
      <% if (logo == true) { %>
         <link rel="icon" href="/assets/logo.png" type="image/x-icon">
      <% }  else { %>
         <link rel="icon" href="https://i.imgur.com/uvDunAR.png" type="image/x-icon">
      <% } %>

      <meta charset="UTF-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <meta content="<%= ogTitle %>" property="og:title">
      <meta content="<%= ogDescription %>" property="og:description">
      <link href="/assets/tailwind.css" rel="stylesheet">
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
   </head>
   <body style="font-family: 'Public Sans'" class="<%= theme['paneltheme-color'] %> h-full w-full" id="main-body">
      <div>
      <!-- Background Image/Video Support -->
      <% if (typeof theme !== 'undefined' && theme['background-image']) { %>
      <style>
        #main-body {
          position: relative;
        }
        #main-body::before {
          content: '';
          position: fixed;
          inset: 0;
          z-index: -1;
          background-image: url('<%= theme["background-image"] %>');
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
          opacity: 0.18;
          pointer-events: none;
        }
      </style>
      <% } %>
      <!-- Todo : remove this style for tailwind css-->
      <style>

         .sidebar nav ul {
            position: relative;
         }
         .nav-link {
            position: relative;
            z-index: 1;
            overflow: hidden;
            transition: color 0.2s ease, background 0.2s ease !important;
         }
         .nav-link::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 0.75rem;
            background: linear-gradient(135deg, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0.03) 60%, rgba(255,255,255,0.08) 100%);
            backdrop-filter: blur(6px) saturate(1.4);
            border: 1px solid rgba(255,255,255,0.10);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 4px 16px rgba(0,0,0,0.15);
            opacity: 0;
            transition: opacity 0.22s cubic-bezier(0.22,1,0.36,1), transform 0.22s cubic-bezier(0.22,1,0.36,1);
            transform: scale(0.96);
            pointer-events: none;
            z-index: -1;
         }
         .nav-link:hover::after {
            opacity: 1;
            transform: scale(1);
         }
         .nav-link:hover {
            color: white !important;
         }
         .nav-link.active {
            color: white;
            font-weight: 500;
         }
         @media (max-width: 1024px) {
            .sidebar {
               display: none;
               position: fixed;
               z-index: 50;
               height: 100%;
               width: 80%;
               background-color: #101010;
               overflow-y: auto;
               transform: translateX(-100%);
               transition: transform 0.3s ease-in-out;
            }
            .sidebar.open {
               display: block;
               transform: translateX(0);
            }
            .sidebar.expanded {
               width: 100%;
            }
         }
         



      </style>
<script>
  // Detect if panel theme is light and add class for CSS targeting
  (function(){
    var body = document.body;
    var bg = window.getComputedStyle(body).backgroundColor;
    var m = bg.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
    if (m) {
      var r=+m[1],g=+m[2],b=+m[3];
      var lum = 0.299*r + 0.587*g + 0.114*b;
      if (lum > 100) body.classList.add('theme-light');
      else body.classList.add('theme-dark');
    } else {
      body.classList.add('theme-dark');
    }
  })();

   document.addEventListener('DOMContentLoaded', () => {
      const loader = document.getElementById('loader');
      const content = document.getElementById('content');

      // Reset any stale inline styles left by nav animation before redirect
      if (content) {
        content.style.opacity = '';
        content.style.transform = '';
        content.style.transition = '';
      }

      setTimeout(() => {
         loader.classList.add('opacity-0');
         if (content) {
           content.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
           content.style.opacity = '1';
           content.style.transform = 'translateY(0)';
           content.classList.add('opacity-100');
         }
         setTimeout(() => { loader.style.display = 'none'; }, 400);
      }, 200);
   });
</script>

<script>
   document.addEventListener('DOMContentLoaded', () => {
      const sidebar = document.getElementById('pc-sidebar');
      const sidebar2 = document.getElementById('pc-sidebar2');
      const colcont = document.getElementById('colcont');

      if ('<%= theme["sidebar-direction"] %>' === 'right') {
         sidebar.classList.add('right-0');
         colcont.classList.add('colcontextream');
         colcont.classList.add('colcont-right');
         sidebar2.classList.remove('rounded-r-3xl', 'rounded-l-lg');
         sidebar2.classList.add('rounded-r-lg', 'rounded-l-3xl');
      } else {
         sidebar.classList.add('left-0');
      }
   });
</script>

