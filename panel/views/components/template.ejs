  <!-- Background Music Player -->
  <% if (typeof settings !== 'undefined' && settings && settings.backgroundMusic && settings.backgroundMusic.enabled && settings.backgroundMusic.url) { %>
  <audio id="bg-music" loop style="display:none" preload="auto">
    <source src="<%= settings.backgroundMusic.url %>" type="audio/mpeg">
  </audio>
  <button onclick="toggleMusic()" id="music-toggle-btn" title="Toggle Music" style="position:fixed;bottom:20px;right:20px;z-index:9999;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:50%;width:44px;height:44px;display:flex;align-items:center;justify-content:center;cursor:pointer;backdrop-filter:blur(10px);transition:all 0.2s;">
    <svg id="music-icon-on" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 256 256">
      <path d="M210.3,56.34l-80-24A8,8,0,0,0,120,40V148.26A48,48,0,1,0,136,184V50.75l69.7,20.91A8,8,0,0,0,210.3,56.34ZM88,216a32,32,0,1,1,32-32A32,32,0,0,1,88,216Z"/>
    </svg>
    <svg id="music-icon-off" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white hidden" fill="currentColor" viewBox="0 0 256 256">
      <path d="M53.92,34.62A8,8,0,1,0,42.08,45.38L72,78.25V148.26A48,48,0,1,0,88,184a47.74,47.74,0,0,0-16-35.66V95.13l130.08,141.25A8,8,0,0,0,208,240a8,8,0,0,0,5.92-13.38ZM88,216a32,32,0,1,1,32-32A32,32,0,0,1,88,216Zm44-129.38V40a8,8,0,0,1,10.3-7.66l80,24a8,8,0,0,1-4.6,15.32L104,50.75Z"/>
    </svg>
  </button>
  <script>
    var bgMusic = document.getElementById('bg-music');
    var iconOn  = document.getElementById('music-icon-on');
    var iconOff = document.getElementById('music-icon-off');
    var musicPlaying = false;
    var MUSIC_KEY = 'skyport_music_playing';
    var MUSIC_TIME_KEY = 'skyport_music_time';

    // BroadcastChannel to sync music state between tabs
    var bc = null;
    try { bc = new BroadcastChannel('skyport_music'); } catch(e) {}

    function setPlayingUI(playing) {
      musicPlaying = playing;
      if (playing) { iconOn.classList.remove('hidden'); iconOff.classList.add('hidden'); }
      else          { iconOn.classList.add('hidden');    iconOff.classList.remove('hidden'); }
    }

    function tryPlay() {
      // Restore playback position for continuity
      var savedTime = parseFloat(sessionStorage.getItem(MUSIC_TIME_KEY) || '0');
      if (savedTime > 0 && isFinite(savedTime)) {
        bgMusic.currentTime = savedTime;
      }
      bgMusic.play().then(function() { setPlayingUI(true); }).catch(function() {});
    }

    // Save playback time periodically
    setInterval(function() {
      if (musicPlaying && bgMusic) {
        sessionStorage.setItem(MUSIC_TIME_KEY, bgMusic.currentTime);
      }
    }, 1000);

    // Check persisted state
    var persistedState = sessionStorage.getItem(MUSIC_KEY);

    if (persistedState === 'playing') {
      // Was playing before navigation — resume
      document.addEventListener('DOMContentLoaded', function() {
        tryPlay();
      });
    }

    // Fallback: on first user interaction
    function initOnInteract() {
      if (!musicPlaying && persistedState !== 'stopped') tryPlay();
      document.removeEventListener('click', initOnInteract);
      document.removeEventListener('keydown', initOnInteract);
    }
    if (persistedState !== 'stopped') {
      document.addEventListener('click', initOnInteract, { once: true });
      document.addEventListener('keydown', initOnInteract, { once: true });
    }

    // Before page unload — save state and time
    window.addEventListener('beforeunload', function() {
      sessionStorage.setItem(MUSIC_KEY, musicPlaying ? 'playing' : 'stopped');
      if (bgMusic) sessionStorage.setItem(MUSIC_TIME_KEY, bgMusic.currentTime);
    });

    function toggleMusic() {
      if (musicPlaying) {
        bgMusic.pause();
        setPlayingUI(false);
        sessionStorage.setItem(MUSIC_KEY, 'stopped');
        if (bc) bc.postMessage({type:'pause'});
      } else {
        tryPlay();
        sessionStorage.setItem(MUSIC_KEY, 'playing');
        if (bc) bc.postMessage({type:'play'});
      }
    }

    // Listen for cross-tab music sync
    if (bc) {
      bc.onmessage = function(e) {
        if (e.data.type === 'pause' && musicPlaying) { bgMusic.pause(); setPlayingUI(false); }
        if (e.data.type === 'play' && !musicPlaying) { tryPlay(); }
      };
    }
  </script>
  <% } %>

<!-- ===== POPUP NOTIFICATION SYSTEM ===== -->
<div id="popup-container" style="position:fixed;top:1.25rem;right:1.25rem;z-index:99999;display:flex;flex-direction:column;gap:0.75rem;pointer-events:none;"></div>
<style>
  @keyframes popup-spin-enter {
    0%   { transform: rotate(0deg) scale(0.5); opacity: 0; }
    70%  { transform: rotate(360deg) scale(1.05); opacity: 1; }
    100% { transform: rotate(360deg) scale(1); opacity: 1; }
  }
  @keyframes popup-fade-out {
    0%   { opacity: 1; transform: translateX(0); }
    100% { opacity: 0; transform: translateX(2rem); }
  }
  .popup-toast {
    pointer-events: all;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 0.875rem;
    background: rgba(20,20,20,0.92);
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(16px);
    max-width: 320px;
    min-width: 220px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
    animation: popup-spin-enter 0.55s cubic-bezier(0.22,1,0.36,1) forwards;
    position: relative;
    overflow: hidden;
  }
  .popup-toast.removing { animation: popup-fade-out 0.3s ease forwards; }
  .popup-icon-wrap { flex-shrink:0; width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; }
  .popup-body { flex:1; min-width:0; }
  .popup-title { font-size:0.8125rem; font-weight:600; color:#fff; margin:0 0 2px; }
  .popup-msg   { font-size:0.75rem; color:rgba(255,255,255,0.55); margin:0; word-break:break-word; }
  .popup-close { flex-shrink:0; background:none; border:none; color:rgba(255,255,255,0.3); cursor:pointer; padding:0; line-height:1; font-size:1rem; transition:color 0.15s; }
  .popup-close:hover { color:rgba(255,255,255,0.8); }
  .popup-progress { position:absolute; bottom:0; left:0; height:3px; border-radius:0 0 0.875rem 0.875rem; transition:width linear; }
</style>
<script>
  function removePopup(el) {
    clearTimeout(el._timer);
    el.classList.add('removing');
    setTimeout(function() { if (el.parentNode) el.remove(); }, 350);
  }
  window.showPopup = function(type, title, message, duration) {
    duration = duration || 4500;
    const container = document.getElementById('popup-container');
    const colors = {
      success: { bg:'rgba(34,197,94,0.15)',  border:'rgba(34,197,94,0.3)',  icon:'#22c55e', bar:'#22c55e' },
      error:   { bg:'rgba(239,68,68,0.15)',   border:'rgba(239,68,68,0.3)',  icon:'#ef4444', bar:'#ef4444' },
      info:    { bg:'rgba(99,102,241,0.15)',  border:'rgba(99,102,241,0.3)', icon:'#818cf8', bar:'#818cf8' },
      warning: { bg:'rgba(234,179,8,0.15)',   border:'rgba(234,179,8,0.3)',  icon:'#facc15', bar:'#facc15' },
    };
    const c = colors[type] || colors.info;
    const icons = {
      success: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M173.66,98.34a8,8,0,0,1,0,11.32l-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35A8,8,0,0,1,173.66,98.34ZM232,128A104,104,0,1,1,128,24,104.11,104.11,0,0,1,232,128Zm-16,0a88,88,0,1,0-88,88A88.1,88.1,0,0,0,216,128Z"/></svg>',
      error:   '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M236.8,188.09,149.35,36.22a24.76,24.76,0,0,0-42.7,0L19.2,188.09a23.51,23.51,0,0,0,0,23.72A24.35,24.35,0,0,0,40.55,224h174.9a24.35,24.35,0,0,0,21.33-12.19A23.51,23.51,0,0,0,236.8,188.09ZM120,104a8,8,0,0,1,16,0v40a8,8,0,0,1-16,0Zm8,88a12,12,0,1,1,12-12A12,12,0,0,1,128,192Z"/></svg>',
      info:    '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"/></svg>',
      warning: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm-8-80V104a8,8,0,0,1,16,0v32a8,8,0,0,1-16,0Zm20,36a12,12,0,1,1-12-12A12,12,0,0,1,140,172Z"/></svg>',
    };
    const toast = document.createElement('div');
    toast.className = 'popup-toast';
    toast.style.borderColor = c.border;
    toast.innerHTML = '<div class="popup-icon-wrap" style="background:' + c.bg + ';color:' + c.icon + ';">' + (icons[type] || icons.info) + '</div><div class="popup-body"><p class="popup-title">' + title + '</p>' + (message ? '<p class="popup-msg">' + message + '</p>' : '') + '</div><button class="popup-close" onclick="removePopup(this.closest(\'.popup-toast\'))">&#x2715;</button><div class="popup-progress" style="background:' + c.bar + ';width:100%;transition-duration:' + duration + 'ms;"></div>';
    container.appendChild(toast);
    requestAnimationFrame(function() { requestAnimationFrame(function() { toast.querySelector('.popup-progress').style.width = '0%'; }); });
    toast._timer = setTimeout(function() { removePopup(toast); }, duration);
  };
  document.addEventListener('DOMContentLoaded', function() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('saved') === '1') window.showPopup('success', 'Saved', 'Settings saved successfully.');
    if (params.get('added') === '1') window.showPopup('success', 'Added', 'Remote panel added.');
    if (params.get('deleted') === '1') window.showPopup('info', 'Removed', 'Entry removed.');
    if (params.get('err')) window.showPopup('error', 'Error', decodeURIComponent(params.get('err')));
    if (params.get('success')) window.showPopup('success', 'Success', decodeURIComponent(params.get('success')));
  });
</script>

<!-- ===== SEASONAL PARTICLE EFFECTS ===== -->
<canvas id="particles-canvas" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0;display:none;"></canvas>
<script>
(function() {
  var particlesSettings = null;
  try { particlesSettings = <%- JSON.stringify((typeof settings !== 'undefined' && settings && settings.particles) ? settings.particles : null) %>; } catch(e) {}
  if (!particlesSettings || !particlesSettings.enabled) return;

  var canvas = document.getElementById('particles-canvas');
  canvas.style.display = 'block';
  var ctx = canvas.getContext('2d');
  var COUNT = Math.min(500, Math.max(10, particlesSettings.count || 80));
  var SIZE  = Math.min(20, Math.max(2, particlesSettings.size || 5));
  var SEASONAL = particlesSettings.seasonal || false;

  function getSeasonColors() {
    if (!SEASONAL) return ['rgba(255,255,255,0.7)', 'rgba(255,255,255,0.4)'];
    var m = new Date().getMonth();
    if (m === 11 || m <= 1)  return ['rgba(200,230,255,0.85)', 'rgba(180,220,255,0.5)'];
    if (m >= 2 && m <= 4)   return ['rgba(255,190,210,0.8)',  'rgba(255,140,180,0.5)'];
    if (m >= 5 && m <= 7)   return ['rgba(255,230,80,0.7)',   'rgba(160,255,100,0.45)'];
    return                         ['rgba(255,150,50,0.75)',  'rgba(200,80,20,0.5)'];
  }

  function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
  resize();
  window.addEventListener('resize', resize);

  var colors = getSeasonColors();
  var particles = [];
  for (var i = 0; i < COUNT; i++) {
    particles.push({
      x: Math.random() * window.innerWidth,
      y: Math.random() * window.innerHeight - window.innerHeight,
      r: Math.random() * SIZE + SIZE * 0.4,
      speed: Math.random() * 1.5 + 0.5,
      drift: (Math.random() - 0.5) * 0.6,
      opacity: Math.random() * 0.6 + 0.3,
      color: Math.random() > 0.5 ? colors[0] : colors[1],
      angle: Math.random() * Math.PI * 2,
      spin: (Math.random() - 0.5) * 0.03,
    });
  }

  function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (var j = 0; j < particles.length; j++) {
      var p = particles[j];
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.angle);
      ctx.globalAlpha = p.opacity;
      ctx.strokeStyle = p.color;
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      for (var k = 0; k < 6; k++) {
        var a = (Math.PI / 3) * k;
        ctx.moveTo(0, 0);
        ctx.lineTo(Math.cos(a) * p.r, Math.sin(a) * p.r);
      }
      ctx.stroke();
      ctx.fillStyle = p.color;
      ctx.beginPath();
      ctx.arc(0, 0, p.r * 0.3, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      p.y += p.speed;
      p.x += p.drift;
      p.angle += p.spin;
      if (p.y > canvas.height + p.r * 2) {
        p.y = -p.r * 2;
        p.x = Math.random() * canvas.width;
      }
      if (p.x < -p.r * 2) p.x = canvas.width + p.r;
      if (p.x > canvas.width + p.r * 2) p.x = -p.r;
    }
    requestAnimationFrame(draw);
  }
  draw();
})();
</script>
