<%- include('../components/template') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xterm/3.14.5/xterm.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/xterm/3.14.5/xterm.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xterm/3.14.5/addons/fit/fit.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js"></script>
<style>
  canvas { position:absolute; left:0; top:0; width:100%!important; height:100%!important; }
  .xterm-viewport { overflow-y:hidden!important; }
</style>

<main class="overflow-hidden" id="content">
  <div class="bg-transparent">
    <div class="sm:flex sm:items-center px-8 pt-4">
      <div class="sm:flex-auto">
        <h1 class="text-base font-medium leading-6 text-white flex items-center gap-2">
          <%= instance.Name %>
          <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/15 text-indigo-400 font-normal capitalize">
            Remote · <%= instance._remoteProxy.panelType %>
          </span>
        </h1>
        <p class="mt-1 tracking-tight text-sm text-neutral-500">
          <%= remote ? remote.displayName : instance._remoteProxy.remoteId %> · <span class="font-mono text-xs"><%= instance._remoteProxy.serverId %></span>
        </p>
      </div>
      <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex gap-2.5">
        <button id="startButton" class="block rounded-xl bg-emerald-600 px-3 py-2 text-center text-sm font-medium text-white shadow-lg hover:bg-emerald-500 transition">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 inline-flex mr-1 mb-0.5"><path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd"/></svg>
          Start
        </button>
        <button id="restartButton" class="block rounded-xl bg-white/20 px-3 py-2 text-center text-sm font-medium text-white shadow-lg hover:bg-white/25 transition">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 inline-flex mr-1 mb-0.5"><path fill-rule="evenodd" d="M4.755 10.059a7.5 7.5 0 0 1 12.548-3.364l1.903 1.903h-3.183a.75.75 0 1 0 0 1.5h4.992a.75.75 0 0 0 .75-.75V4.356a.75.75 0 0 0-1.5 0v3.18l-1.9-1.9A9 9 0 0 0 3.306 9.67a.75.75 0 1 0 1.45.388Zm15.408 3.352a.75.75 0 0 0-.919.53 7.5 7.5 0 0 1-12.548 3.364l-1.902-1.903h3.183a.75.75 0 0 0 0-1.5H2.984a.75.75 0 0 0-.75.75v4.992a.75.75 0 0 0 1.5 0v-3.18l1.9 1.9a9 9 0 0 0 15.059-4.035.75.75 0 0 0-.53-.918Z" clip-rule="evenodd"/></svg>
          Restart
        </button>
        <button id="stopButton" class="block rounded-xl bg-red-600 px-3 py-2 text-center text-sm font-medium text-white shadow-lg hover:bg-red-500 transition">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4 inline-flex mr-1 mb-0.5"><path fill-rule="evenodd" d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z" clip-rule="evenodd"/></svg>
          Stop
        </button>
      </div>
    </div>
  </div>

  <!-- Nav tabs (only Console available for remote) -->
  <div class="mt-6 ml-8 mb-4">
    <nav class="flex">
      <ul class="flex min-w-full flex-none gap-x-2 text-sm font-normal leading-6 text-neutral-400">
        <li>
          <a href="/instance/<%= req.params.id %>" class="text-white font-medium border border-transparent bg-white/10 py-2 px-3 rounded-xl shadow-sm flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="size-4 mb-0.5 inline-flex mr-1"><path d="M216,40H40A16,16,0,0,0,24,56V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A16,16,0,0,0,216,40Zm-91,94.25-40,32a8,8,0,1,1-10-12.5L107.19,128,75,102.25a8,8,0,1,1,10-12.5l40,32a8,8,0,0,1,0,12.5ZM176,168H136a8,8,0,0,1,0-16h40a8,8,0,0,1,0,16Z"/></svg>
            Console
          </a>
        </li>
        <% if (remote) { %>
        <li>
          <a href="<%= remote.panelUrl %>/server/<%= instance._remoteProxy.serverId %>" target="_blank"
            class="py-2 px-3 transition border hover:bg-white/5 border-transparent hover:text-white hover:shadow rounded-xl flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" class="size-4 mb-0.5 inline-flex mr-1"><path d="M224,104a8,8,0,0,1-16,0V59.32l-82.34,82.34a8,8,0,0,1-11.32-11.32L196.68,48H152a8,8,0,0,1,0-16h64a8,8,0,0,1,8,8Zm-40,24a8,8,0,0,0-8,8v72H48V80h72a8,8,0,0,0,0-16H48A16,16,0,0,0,32,80V208a16,16,0,0,0,16,16H176a16,16,0,0,0,16-16V136A8,8,0,0,0,184,128Z"/></svg>
            Mở trong <%= instance._remoteProxy.panelType %>
          </a>
        </li>
        <% } %>
      </ul>
    </nav>
  </div>

  <!-- Info cards -->
  <div class="mt-2 ml-8 mb-4 mr-8">
    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="overflow-hidden rounded-xl bg-white/5 px-4 py-5 shadow sm:p-6 flex items-center">
        <div class="flex-grow">
          <dt class="truncate text-sm font-medium text-neutral-400">Panel</dt>
          <dd class="mt-1 text-base font-medium tracking-tight text-white truncate">
            <%= remote ? remote.displayName : 'Remote' %>
          </dd>
        </div>
        <div class="ml-4 shadow border border-white/10 rounded-xl p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-indigo-400" fill="currentColor" viewBox="0 0 256 256"><path d="M208,40H48A16,16,0,0,0,32,56v48a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V56A16,16,0,0,0,208,40ZM180,88a12,12,0,1,1,12-12A12,12,0,0,1,180,88Z"/><path d="M208,136H48a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V152A16,16,0,0,0,208,136Zm-28,52a12,12,0,1,1,12-12A12,12,0,0,1,180,188Z"/></svg>
        </div>
      </div>
      <div class="overflow-hidden rounded-xl bg-white/5 px-4 py-5 shadow sm:p-6 flex items-center">
        <div class="flex-grow">
          <dt class="truncate text-sm font-medium text-neutral-400">Loại panel</dt>
          <dd class="mt-1 text-base font-medium tracking-tight text-white capitalize"><%= instance._remoteProxy.panelType %></dd>
        </div>
        <div class="ml-4 shadow border border-white/10 rounded-xl p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-neutral-400" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm88,104a87.47,87.47,0,0,1-2.64,21.18H174.27a146.15,146.15,0,0,0,1.73-21.18,146.15,146.15,0,0,0-1.73-21.18h39.09A87.47,87.47,0,0,1,216,128ZM40,128a87.47,87.47,0,0,1,2.64-21.18H81.73A146.15,146.15,0,0,0,80,128a146.15,146.15,0,0,0,1.73,21.18H42.64A87.47,87.47,0,0,1,40,128Z"/></svg>
        </div>
      </div>
      <div class="overflow-hidden rounded-xl bg-white/5 px-4 py-5 shadow sm:p-6 flex items-center">
        <div class="flex-grow">
          <dt class="truncate text-sm font-medium text-neutral-400">RAM Limit</dt>
          <dd class="mt-1 text-base font-medium tracking-tight text-white">
            <% var mem = instance._remoteProxy.limits && instance._remoteProxy.limits.memory; %>
            <%= mem ? (mem >= 1024 ? (mem/1024).toFixed(1)+'GB' : mem+'MB') : '∞' %>
          </dd>
        </div>
        <div class="ml-4 shadow border border-white/10 rounded-xl p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-neutral-400" fill="currentColor" viewBox="0 0 256 256"><path d="M240,96H216V80a16,16,0,0,0-16-16H168V48a16,16,0,0,0-16-16H104A16,16,0,0,0,88,48V64H56A16,16,0,0,0,40,80V96H16a8,8,0,0,0,0,16H40v48H16a8,8,0,0,0,0,16H40v16a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V176h24a8,8,0,0,0,0-16H216V112h24a8,8,0,0,0,0-16Z"/></svg>
        </div>
      </div>
      <div class="overflow-hidden rounded-xl bg-white/5 px-4 py-5 shadow sm:p-6 flex items-center">
        <div class="flex-grow">
          <dt class="truncate text-sm font-medium text-neutral-400">Server ID</dt>
          <dd class="mt-1 text-sm font-mono tracking-tight text-white truncate"><%= instance._remoteProxy.serverId %></dd>
        </div>
        <div class="ml-4 shadow border border-white/10 rounded-xl p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-neutral-400" fill="currentColor" viewBox="0 0 256 256"><path d="M224,48V208a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V48A16,16,0,0,1,48,32H208A16,16,0,0,1,224,48Zm-16,0H48V208H208Z"/></svg>
        </div>
      </div>
    </dl>
  </div>

  <!-- Console + Stats -->
  <div class="flex flex-col lg:flex-row px-8 mb-8">
    <!-- Console -->
    <div class="w-full lg:w-2/3 lg:pr-5">
      <div class="bg-[#101010]/50 rounded-t-xl p-4">
        <div id="terminal" class="overflow-x-auto whitespace-pre-wrap"></div>
      </div>
      <input id="input" type="text" autocomplete="off" placeholder="Send a command..."
        class="w-full px-4 py-3 bg-[#101010]/30 text-white rounded-b-xl text-sm border-t border-transparent focus:ring-transparent focus:border-transparent placeholder:font-medium placeholder:text-neutral-500">
    </div>
    <!-- Stats -->
    <div class="w-full lg:w-1/3 mt-4 lg:mt-0 space-y-4">
      <div class="bg-white/5 rounded-xl px-4 py-5 shadow sm:p-6 h-24 relative overflow-hidden">
        <canvas id="statusChart" class="absolute inset-0 w-full h-full"></canvas>
        <div class="relative z-10">
          <h2 class="text-sm font-medium text-neutral-400">Status</h2>
          <p id="status" class="mt-1 text-lg font-medium tracking-tight text-white">-</p>
        </div>
      </div>
      <div class="bg-white/5 rounded-xl px-4 py-5 shadow sm:p-6 h-24 relative overflow-hidden">
        <canvas id="ramChart" class="absolute inset-0 w-full h-full"></canvas>
        <div class="relative z-10">
          <h2 class="text-sm font-medium text-neutral-400">RAM Usage</h2>
          <p id="ramUsage" class="mt-1 text-lg font-medium tracking-tight text-white"></p>
        </div>
      </div>
      <div class="bg-white/5 rounded-xl px-4 py-5 shadow sm:p-6 h-24 relative overflow-hidden">
        <canvas id="cpuChart" class="absolute inset-0 w-full h-full"></canvas>
        <div class="relative z-10">
          <h2 class="text-sm font-medium text-neutral-400">CPU Usage</h2>
          <p id="cpuUsage" class="mt-1 text-lg font-medium tracking-tight text-white"></p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../components/footer') %>

<script>
const instanceId   = '<%= req.params.id %>';
const panelType    = '<%= instance._remoteProxy.panelType %>';
const remoteId     = '<%= instance._remoteProxy.remoteId %>';
const protocol     = window.location.protocol === 'https:' ? 'wss' : 'ws';
const port         = window.location.port ? ':' + window.location.port : '';
const memLimitMb   = <%= (instance._remoteProxy.limits && instance._remoteProxy.limits.memory) || 0 %>;

let term, ws, statsWs;
let ramData = [], cpuData = [], statusData = [];
let ramChart, cpuChart, statusChart;

// ── Terminal setup ────────────────────────────────────────────────────────────
const baseTheme = { foreground:'#c5c9d1', background:'rgba(0 0 0 / 0)', cursor:'#c5c9d1', selectionBackground:'rgba(255,255,255,0.3)', black:'#000000', red:'#d16969', green:'#4ec994', yellow:'#d7ba7d', blue:'#569cd6', magenta:'#c586c0', cyan:'#9cdcfe', white:'#d4d4d4', brightBlack:'#808080', brightRed:'#f44747', brightGreen:'#89d185', brightYellow:'#dcdcaa', brightBlue:'#75beff', brightMagenta:'#c586c0', brightCyan:'#9cdcfe', brightWhite:'#ffffff' };

function setupTerminal() {
  term = new Terminal({ theme: baseTheme, fontSize: 13, fontFamily: 'Menlo, monospace', cursorStyle: 'block', cursorBlink: true, scrollback: 5000 });
  term.open(document.getElementById('terminal'));
  if (term.fit) term.fit();
}

function connectConsole() {
  ws = new WebSocket(`${protocol}://${window.location.hostname}${port}/remote-console/${instanceId}`);
  ws.onopen = () => { term && term.writeln('\x1b[32mConnected to remote console.\x1b[0m'); };
  ws.onmessage = (e) => {
    if (term) {
      // xterm expects \r\n
      term.write(e.data.replace(/\n/g, '\r\n'));
    }
  };
  ws.onclose = () => {
    if (term) term.writeln('\x1b[31mConsole disconnected. Reconnecting...\x1b[0m');
    setTimeout(connectConsole, 4000);
  };
  ws.onerror = () => {
    if (term) term.writeln('\x1b[31mConnection error.\x1b[0m');
  };
}

function sendCommand() {
  const input = document.getElementById('input');
  const cmd = input.value.trim();
  if (!cmd) return;
  input.value = '';
  if (ws && ws.readyState === WebSocket.OPEN) {
    // Send as Pterodactyl "send command" event — RemoteProxy.js handles routing
    ws.send(JSON.stringify({ event: 'send command', args: [cmd] }));
    if (term) term.writeln('\x1b[36m> ' + cmd + '\x1b[0m');
  } else {
    // Fallback: HTTP
    fetch('/instance/' + instanceId + '/remote-command', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: cmd })
    }).then(r => r.json()).then(d => {
      if (term) term.writeln(d.success ? '\x1b[32mSent: ' + cmd + '\x1b[0m' : '\x1b[31mError: ' + (d.error||'failed') + '\x1b[0m');
    });
  }
}

// ── Stats WebSocket ──────────────────────────────────────────────────────────
function formatBytes(kb) {
  if (kb < 1024) return kb.toFixed(0) + ' KB';
  if (kb < 1024*1024) return (kb/1024).toFixed(1) + ' MB';
  return (kb/1024/1024).toFixed(2) + ' GB';
}

function makeChart(id, color) {
  const ctx = document.getElementById(id);
  if (!ctx) return null;
  return new Chart(ctx, {
    type: 'line',
    data: { labels: Array(20).fill(''), datasets: [{ data: Array(20).fill(0), borderColor: color, borderWidth: 1.5, fill: true, backgroundColor: color.replace(')', ',0.07)').replace('rgb','rgba'), tension: 0.4, pointRadius: 0 }] },
    options: { responsive: false, animation: false, plugins: { legend: { display: false } }, scales: { x: { display: false }, y: { display: false, min: 0 } } }
  });
}

function pushChart(chart, arr, val) {
  arr.push(val);
  if (arr.length > 20) arr.shift();
  chart.data.datasets[0].data = [...arr];
  chart.update('none');
}

function connectStats() {
  statsWs = new WebSocket(`${protocol}://${window.location.hostname}${port}/remote-stats/${instanceId}`);
  statsWs.onmessage = (e) => {
    let stats;
    try { stats = JSON.parse(e.data); } catch { return; }

    const memUsage = stats.memory_stats.usage / 1024; // KB
    const memLimit = memLimitMb > 0 ? memLimitMb * 1024 : (stats.memory_stats.limit / 1024);

    // RAM
    const ramUsageEl = document.getElementById('ramUsage');
    if (ramUsageEl) ramUsageEl.textContent = formatBytes(memUsage) + ' / ' + formatBytes(memLimit);
    if (ramChart) pushChart(ramChart, ramData, memUsage);

    // CPU — use _cpuPercent if available (remote stats send it), else calculate
    let cpuPct = stats._cpuPercent || 0;
    if (!stats._cpuPercent) {
      const delta = stats.cpu_stats.cpu_usage.total_usage - stats.precpu_stats.cpu_usage.total_usage;
      const sysDelta = stats.cpu_stats.system_cpu_usage - stats.precpu_stats.system_cpu_usage;
      cpuPct = (delta && sysDelta) ? (delta / sysDelta) * 100 : 0;
    }
    const cpuEl = document.getElementById('cpuUsage');
    if (cpuEl) cpuEl.textContent = cpuPct.toFixed(2) + '% CPU';
    if (cpuChart) pushChart(cpuChart, cpuData, cpuPct);

    // Status derived from RAM
    const statusEl  = document.getElementById('status');
    if (memUsage > 1) {
      if (statusEl) { statusEl.textContent = 'Online'; statusEl.className = 'mt-1 text-lg font-medium tracking-tight text-emerald-400'; }
      if (statusChart) pushChart(statusChart, statusData, 1);
    } else {
      if (statusEl) { statusEl.textContent = 'Offline'; statusEl.className = 'mt-1 text-lg font-medium tracking-tight text-red-400'; }
      if (statusChart) pushChart(statusChart, statusData, 0);
    }
  };
  statsWs.onclose = () => setTimeout(connectStats, 5000);
}

// ── Power buttons ────────────────────────────────────────────────────────────
function sendPower(action) {
  // Try via WS first (Pterodactyl supports power events over WS)
  if (ws && ws.readyState === WebSocket.OPEN && (panelType === 'pterodactyl' || panelType === 'pelican')) {
    ws.send(JSON.stringify({ event: 'set state', args: [action] }));
    window.showPopup && window.showPopup('success', 'Lệnh gửi thành công', action);
    return;
  }
  // HTTP fallback
  fetch('/instance/' + instanceId + '/power', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ action: action })
  }).then(r => r.json()).then(d => {
    if (d.success || d.Success) {
      window.showPopup && window.showPopup('success', 'Thực hiện thành công', action);
    } else {
      window.showPopup && window.showPopup('error', 'Lỗi', d.error || 'Thực hiện thất bại');
    }
  }).catch(e => window.showPopup && window.showPopup('error', 'Lỗi mạng', e.message));
}

document.addEventListener('DOMContentLoaded', () => {
  setupTerminal();
  connectConsole();
  connectStats();

  ramChart    = makeChart('ramChart',    'rgb(99,102,241)');
  cpuChart    = makeChart('cpuChart',    'rgb(234,179,8)');
  statusChart = makeChart('statusChart', 'rgb(34,197,94)');

  document.getElementById('input').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') sendCommand();
  });

  document.getElementById('startButton').addEventListener('click',   () => sendPower('start'));
  document.getElementById('restartButton').addEventListener('click', () => sendPower('restart'));
  document.getElementById('stopButton').addEventListener('click',    () => sendPower('stop'));
});
</script>
