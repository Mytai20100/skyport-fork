<%- include('../components/template') %>

<style>
/* Liquid Glass Sidebar Hover Effect */
.nav-link {
  position: relative;
  overflow: hidden;
}
.nav-link::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 0.75rem;
  background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, rgba(255,255,255,0.04) 100%);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,0.08);
  opacity: 0;
  transition: opacity 0.2s ease, transform 0.2s ease;
  transform: scale(0.95);
  pointer-events: none;
  z-index: 0;
}
.nav-link:hover::before {
  opacity: 1;
  transform: scale(1);
}
.nav-link:hover {
  color: white !important;
}
.nav-link span, .nav-link svg {
  position: relative;
  z-index: 1;
}
</style>

<style>
/* Adaptive panel action buttons — works on dark AND light themes */
.btn-panel-action {
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.18);
  color: #e5e5e5;
}
.btn-panel-action:hover {
  background: rgba(255,255,255,0.22);
  color: #ffffff;
}
.btn-panel-danger {
  background: rgba(220,38,38,0.15);
  border: 1px solid rgba(220,38,38,0.3);
  color: #f87171;
}
.btn-panel-danger:hover {
  background: rgba(220,38,38,0.28);
  color: #fca5a5;
}
/* Light theme overrides */
.theme-light .btn-panel-action {
  background: rgba(0,0,0,0.08);
  border-color: rgba(0,0,0,0.18);
  color: #1a1a1a;
}
.theme-light .btn-panel-action:hover {
  background: rgba(0,0,0,0.15);
  color: #000;
}
.theme-light .btn-panel-danger {
  background: rgba(220,38,38,0.10);
  border-color: rgba(220,38,38,0.3);
  color: #b91c1c;
}
.theme-light .btn-panel-danger:hover {
  background: rgba(220,38,38,0.2);
  color: #991b1b;
}
</style>

<main id="content">
  <div class="px-8 pt-4 pb-2 flex items-center justify-between">
    <div>
      <h1 class="text-base font-medium leading-6 text-white">Remote Instances</h1>
      <p class="mt-1 tracking-tight text-sm text-neutral-500">Connect servers from external panels via API key - they will appear automatically in Instances.</p>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="openApiKeyManagerModal()"
        class="btn-panel-action block rounded-xl px-3 py-2 text-center text-sm font-medium shadow-lg transition">
        Manage API Keys
      </button>
      <button onclick="openAddModal()"
        class="block rounded-xl <%= theme['button-color'] %> px-3 py-2 text-center text-sm font-medium shadow-lg transition">
        Add Remote Panel
      </button>
    </div>
  </div>

  <div class="flex flex-col bg-white/5 mx-8 mt-5 mb-8 rounded-xl overflow-hidden">
    <h2 class="text-white text-[15px] px-5 py-3.5 bg-white/5 font-medium">
      Connected Panels
      <% if (remoteInstances.length > 0) { %>
      <span class="ml-2 text-xs text-neutral-500 font-normal"><%= remoteInstances.length %> panel</span>
      <% } %>
    </h2>

    <% if (remoteInstances.length === 0) { %>
    <div class="px-6 py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-neutral-700 mx-auto mb-4" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm88,104a87.47,87.47,0,0,1-2.64,21.18H174.27a146.15,146.15,0,0,0,1.73-21.18,146.15,146.15,0,0,0-1.73-21.18h39.09A87.47,87.47,0,0,1,216,128ZM83.82,160H172.18a130.73,130.73,0,0,1-2.18,16H85.47A130.73,130.73,0,0,1,83.82,160Zm-2.09-32a130,130,0,0,1,0-32H174.27a130,130,0,0,1,0,32ZM40,128a87.47,87.47,0,0,1,2.64-21.18H81.73A146.15,146.15,0,0,0,80,128a146.15,146.15,0,0,0,1.73,21.18H42.64A87.47,87.47,0,0,1,40,128Zm86.12-88c5.78,8.64,10.73,20.2,13.86,32H116c3.13-11.8,8.08-23.36,13.88-32ZM83.06,72H112a131.38,131.38,0,0,0-7.13,24H42.64A88.28,88.28,0,0,1,83.06,72ZM42.64,160H104.9A131.38,131.38,0,0,0,112,184H83.06A88.28,88.28,0,0,1,42.64,160Zm83.48,72c-5.8-8.64-10.75-20.2-13.88-32h27.52C136.63,211.8,131.68,223.36,125.88,232Zm47.06-32H144a131.38,131.38,0,0,0,7.13-24h62.23A88.28,88.28,0,0,1,172.94,200Zm7.13-48H151.1A131.38,131.38,0,0,0,144,128h29A88.28,88.28,0,0,1,180.07,152Z"/></svg>
      <p class="text-neutral-400 text-sm font-medium">No remote panels yet</p>
      <p class="text-neutral-600 text-xs mt-1 mb-4">Click "Add Remote Panel" to get started</p>
      <button onclick="openAddModal()" class="rounded-xl bg-white/10 hover:bg-white/20 text-white px-4 py-2 text-sm font-medium transition">Add first panel</button>
    </div>
    <% } else { %>
    <div class="divide-y divide-white/5">
      <% remoteInstances.forEach(function(remote) { %>
      <% var owner = users.find(function(u) { return u.userId === remote.ownerId; }); %>
      <div class="px-5 py-4">
        <div class="flex items-center gap-3 flex-wrap">
          <div class="w-9 h-9 rounded-xl bg-white/8 border border-white/10 flex items-center justify-center shrink-0">
            <% if (remote.panelType === 'pterodactyl') { %>
            <!-- Pterodactyl favicon-style icon -->
            <svg class="w-5 h-5 text-indigo-300" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M208,40H48A16,16,0,0,0,32,56V200a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V56A16,16,0,0,0,208,40ZM180,92a12,12,0,1,1,12-12A12,12,0,0,1,180,92Zm0,96a12,12,0,1,1,12-12A12,12,0,0,1,180,188Z"/></svg>
            <% } else if (remote.panelType === 'pelican') { %>
            <svg class="w-5 h-5 text-cyan-300" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M245.66,154.34l-32-32a8,8,0,0,0-11.32,0L192,132.69,163.31,104l10.35-10.34a8,8,0,0,0,0-11.32l-32-32a8,8,0,0,0-11.32,0l-96,96a8,8,0,0,0,0,11.32l32,32a8,8,0,0,0,11.32,0L88,179.31l40,40a8,8,0,0,0,11.32,0l106-106A8,8,0,0,0,245.66,154.34Z"/></svg>
            <% } else if (remote.panelType === 'skyport') { %>
            <svg class="w-5 h-5 text-violet-300" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M208,40H48A16,16,0,0,0,32,56v48a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V56A16,16,0,0,0,208,40ZM180,88a12,12,0,1,1,12-12A12,12,0,0,1,180,88ZM208,136H48a16,16,0,0,0-16,16v48a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V152A16,16,0,0,0,208,136Zm-28,52a12,12,0,1,1,12-12A12,12,0,0,1,180,188Z"/></svg>
            <% } else { %>
            <svg class="w-5 h-5 text-neutral-300" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm88,104a87.47,87.47,0,0,1-2.64,21.18H174.27a146.15,146.15,0,0,0,1.73-21.18,146.15,146.15,0,0,0-1.73-21.18h39.09A87.47,87.47,0,0,1,216,128ZM83.82,160H172.18a130.73,130.73,0,0,1-2.18,16H85.47A130.73,130.73,0,0,1,83.82,160Zm-2.09-32a130,130,0,0,1,0-32H174.27a130,130,0,0,1,0,32ZM40,128a87.47,87.47,0,0,1,2.64-21.18H81.73A146.15,146.15,0,0,0,80,128a146.15,146.15,0,0,0,1.73,21.18H42.64A87.47,87.47,0,0,1,40,128Z"/></svg>
            <% } %>
          </div>

          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-white text-sm font-medium"><%= remote.displayName %></span>
              <span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-neutral-400 capitalize"><%= remote.panelType %></span>
              <span id="badge-<%= remote.id %>" class="text-xs px-2 py-0.5 rounded-full bg-white/5 text-neutral-600 flex items-center gap-1">
                <svg class="w-2.5 h-2.5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                checking...
              </span>
            </div>
            <p class="text-neutral-500 text-xs mt-0.5 truncate font-mono"><%= remote.panelUrl %></p>
            <p class="text-neutral-600 text-xs">Owner: <span class="text-neutral-500"><%= owner ? owner.username : remote.ownerId %></span>
              <span id="srv-count-<%= remote.id %>"></span>
            </p>
          </div>

          <div class="flex items-center gap-2 shrink-0 flex-wrap">
            <button onclick="syncPanel('<%= remote.id %>','<%= remote.displayName.replace(/'/g,String.fromCharCode(39)) %>')"
              id="btn-sync-<%= remote.id %>"
              class="btn-panel-action rounded-full px-3.5 py-1.5 text-xs font-semibold transition">
              Sync
            </button>
            <button onclick="toggleServers('<%= remote.id %>')"
              id="btn-servers-<%= remote.id %>"
              class="btn-panel-action rounded-full px-3.5 py-1.5 text-xs font-semibold transition">
              <span id="btn-servers-label-<%= remote.id %>">View servers</span>
            </button>
            <a href="/remote-instances/<%= remote.id %>" class="btn-panel-action rounded-full px-3.5 py-1.5 text-xs font-semibold transition">Chinh sua</a>
            <button onclick="confirmDelete('<%= remote.id %>','<%= remote.displayName.replace(/\'/g, String.fromCharCode(39)) %>')"
              class="btn-panel-danger rounded-full px-3.5 py-1.5 text-xs font-semibold transition">Xoa</button>
          </div>
        </div>

        <div id="servers-<%= remote.id %>" class="hidden mt-4">
          <div class="mb-3 flex gap-2">
            <input id="search-<%= remote.id %>" type="text" placeholder="Search by name, ID..."
              oninput="filterServers('<%= remote.id %>')"
              class="flex-1 rounded-xl bg-white/5 border border-white/10 text-white text-sm px-3 py-2 focus:outline-none focus:border-white/25 transition placeholder:text-neutral-600">
            <button onclick="loadServers('<%= remote.id %>')"
              class="btn-panel-action rounded-xl px-3 py-2 text-xs font-medium transition">
              Refresh
            </button>
          </div>
          <div id="sl-loading-<%= remote.id %>" class="hidden py-8 text-center">
            <svg class="w-5 h-5 mx-auto mb-2 animate-spin text-indigo-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
            <p class="text-neutral-500 text-xs">Loading servers...</p>
          </div>
          <div id="sl-error-<%= remote.id %>" class="hidden rounded-xl bg-red-900/20 border border-red-700/20 px-4 py-3 text-red-400 text-sm"></div>
          <div id="sl-list-<%= remote.id %>"></div>
        </div>
      </div>
      <% }); %>
    </div>
    <% } %>
  </div>
</main>

<!-- ADD MODAL -->
<div id="add-modal" class="hidden fixed inset-0 z-[9999] items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="closeAddModal()"></div>
  <div id="add-modal-box" class="relative bg-neutral-900 border border-white/10 rounded-2xl w-full max-w-lg shadow-2xl overflow-hidden transform transition-all duration-300 scale-95 opacity-0">
    <div class="px-6 py-5 border-b border-white/8 flex items-center justify-between">
      <div>
        <h2 class="text-white font-semibold text-base">Add Remote Panel</h2>
        <p class="text-neutral-500 text-xs mt-0.5">Kết nối panel ngoài qua API Key</p>
      </div>
      <button onclick="closeAddModal()" class="text-neutral-500 hover:text-white p-1 rounded-lg hover:bg-white/10 transition">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <form action="/remote-instances/add" method="POST">
      <div class="px-6 py-5 flex flex-col gap-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1.5">Tên hiển thị</label>
            <input name="displayName" type="text" placeholder="My Panel" required
              class="rounded-xl text-white text-sm w-full px-3 py-2.5 bg-white/5 border border-white/10 placeholder:text-white/20 focus:outline-none focus:border-indigo-500/50 transition">
          </div>
          <div>
            <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1.5">Loại Panel</label>
            <div class="relative">
              <select name="panelType" id="modal-panel-type"
                class="appearance-none rounded-xl text-white text-sm w-full px-3 pr-8 py-2.5 bg-white/5 border border-white/10 focus:outline-none focus:border-indigo-500/50 transition cursor-pointer">
                <option value="pterodactyl" class="bg-neutral-900">Pterodactyl</option>
                <option value="pelican"     class="bg-neutral-900">Pelican</option>
                <option value="skyport"     class="bg-neutral-900">Skyport</option>
                <option value="other"       class="bg-neutral-900">Khác</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-neutral-400">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>
        </div>
        <div>
          <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1.5">Panel URL</label>
          <input name="panelUrl" id="modal-panel-url" type="url" placeholder="https://panel.example.com" required
            class="rounded-xl text-white text-sm w-full px-3 py-2.5 bg-white/5 border border-white/10 placeholder:text-white/20 focus:outline-none focus:border-indigo-500/50 transition">
        </div>
        <div>
          <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1.5">API Key</label>
          <!-- Group API Key selector -->
          <div id="apikey-group-mode">
            <div class="relative mb-2">
              <select id="apikey-group-select" onchange="handleApiKeyGroupSelect(this.value)"
                class="appearance-none rounded-xl text-white text-sm w-full px-3 pr-8 py-2.5 bg-white/5 border border-white/10 focus:outline-none focus:border-indigo-500/50 transition cursor-pointer">
                <option value="" class="bg-neutral-900 text-neutral-400">- Chọn API Key group -</option>
                <% if (typeof apiKeyGroups !== 'undefined' && apiKeyGroups && apiKeyGroups.length > 0) { %>
                  <% apiKeyGroups.forEach(function(g) { %>
                  <option value="<%= g.key %>" data-key="<%= g.key %>" class="bg-neutral-900"><%= g.name %> (<%= g.panelType || 'any' %>)</option>
                  <% }); %>
                <% } %>
                <option value="__custom__" class="bg-neutral-900 text-indigo-300">Nhập thủ công (Custom)</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-neutral-400">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </div>
          </div>
          <!-- Custom API Key input (shown when custom selected) -->
          <div id="apikey-custom-mode" class="hidden">
            <div class="flex items-center gap-2 mb-2">
              <button type="button" onclick="switchToGroupMode()" class="text-xs text-indigo-400 hover:text-indigo-300 flex items-center gap-1 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 256 256"><path d="M224,128a8,8,0,0,1-8,8H59.31l58.35,58.34a8,8,0,0,1-11.32,11.32l-72-72a8,8,0,0,1,0-11.32l72-72a8,8,0,0,1,11.32,11.32L59.31,120H216A8,8,0,0,1,224,128Z"/></svg>
                Quay lại chọn group
              </button>
            </div>
            <div class="relative">
              <input name="apiKey" id="modal-api-key" type="password" placeholder="ptlc_... hoặc bearer token" required
                class="rounded-xl text-white text-sm w-full px-3 pr-10 py-2.5 bg-white/5 border border-white/10 placeholder:text-white/20 focus:outline-none focus:border-indigo-500/50 transition">
              <button type="button" onclick="toggleApiKeyVisibility()" class="absolute inset-y-0 right-0 px-3 text-neutral-500 hover:text-white transition">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              </button>
            </div>
          </div>
          <!-- Hidden input holding the actual key value when group is selected -->
          <input type="hidden" id="modal-api-key-group" name="apiKey" id="modal-api-key-hidden" value="">
          <button type="button" id="btn-test-conn" onclick="testConnection()"
            class="mt-2 btn-panel-action rounded-xl px-3 py-1.5 text-xs font-medium transition">
            Test connection
          </button>
          <div id="test-result" class="hidden mt-2 text-xs px-3 py-2 rounded-xl"></div>
        </div>
        <div>
          <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1.5">Sở hữu bởi</label>
          <div class="relative">
            <select name="ownerId"
              class="appearance-none rounded-xl text-white text-sm w-full px-3 pr-8 py-2.5 bg-white/5 border border-white/10 focus:outline-none focus:border-indigo-500/50 transition cursor-pointer">
              <% users.forEach(function(u) { %>
              <option value="<%= u.userId %>" class="bg-neutral-900"><%= u.username %> (<%= u.email %>)</option>
              <% }); %>
            </select>
            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-neutral-400">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </div>
          </div>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-white/8 flex gap-3 justify-end">
        <button type="button" onclick="closeAddModal()"
          class="rounded-xl bg-white/8 hover:bg-white/15 text-neutral-300 px-4 py-2 text-sm font-medium transition">Huỷ</button>
        <button type="submit"
          class="rounded-xl bg-white text-neutral-900 hover:bg-neutral-200 px-5 py-2 text-sm font-semibold transition">
          Them & Ket noi
        </button>
      </div>
    </form>
  </div>
</div>

<!-- API KEY MANAGER MODAL -->
<div id="apikey-manager-modal" class="hidden fixed inset-0 z-[9999] items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="closeApiKeyManagerModal()"></div>
  <div id="apikey-manager-box" class="relative bg-neutral-900 border border-white/10 rounded-2xl w-full max-w-xl shadow-2xl overflow-hidden transform transition-all duration-300 scale-95 opacity-0">
    <div class="px-6 py-5 border-b border-white/8 flex items-center justify-between">
      <div>
        <h2 class="text-white font-semibold text-base">Manage API Key Groups</h2>
        <p class="text-neutral-500 text-xs mt-0.5">Tạo và quản lý API key groups để dùng cho remote panels</p>
      </div>
      <button onclick="closeApiKeyManagerModal()" class="text-neutral-500 hover:text-white p-1 rounded-lg hover:bg-white/10 transition">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-6 py-5">
      <!-- Create new group form -->
      <div class="bg-white/5 rounded-xl p-4 mb-5">
        <h3 class="text-white text-sm font-medium mb-3">Thêm API Key Group</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3">
          <div>
            <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1">Tên group</label>
            <input id="newgroup-name" type="text" placeholder="Production Keys" class="rounded-xl text-white text-sm w-full px-3 py-2 bg-white/5 border border-white/10 placeholder:text-white/20 focus:outline-none focus:border-indigo-500/50 transition">
          </div>
          <div>
            <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1">Panel Type</label>
            <select id="newgroup-paneltype" class="appearance-none rounded-xl text-white text-sm w-full px-3 py-2 bg-white/5 border border-white/10 focus:outline-none focus:border-indigo-500/50 transition">
              <option value="any" class="bg-neutral-900">Any</option>
              <option value="pterodactyl" class="bg-neutral-900">Pterodactyl</option>
              <option value="pelican" class="bg-neutral-900">Pelican</option>
              <option value="skyport" class="bg-neutral-900">Skyport</option>
            </select>
          </div>
          <div>
            <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1">Sở hữu bởi</label>
            <select id="newgroup-owner" class="appearance-none rounded-xl text-white text-sm w-full px-3 py-2 bg-white/5 border border-white/10 focus:outline-none focus:border-indigo-500/50 transition">
              <% users.forEach(function(u) { %>
              <option value="<%= u.userId %>" class="bg-neutral-900"><%= u.username %></option>
              <% }); %>
            </select>
          </div>
        </div>
        <div class="mb-3">
          <label class="text-neutral-400 text-xs uppercase tracking-wider font-medium block mb-1">API Key</label>
          <div class="relative">
            <input id="newgroup-key" type="password" placeholder="ptlc_... hoặc bearer token" class="rounded-xl text-white text-sm w-full px-3 pr-10 py-2 bg-white/5 border border-white/10 placeholder:text-white/20 focus:outline-none focus:border-indigo-500/50 transition">
            <button type="button" onclick="var i=document.getElementById('newgroup-key');i.type=i.type==='password'?'text':'password'" class="absolute inset-y-0 right-0 px-3 text-neutral-500 hover:text-white transition">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
            </button>
          </div>
        </div>
        <button onclick="createApiKeyGroup()" class="rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 text-sm font-semibold transition">
          Them Group
        </button>
      </div>
      <!-- List of groups -->
      <div id="apikey-groups-list">
        <h3 class="text-neutral-400 text-xs uppercase tracking-wider font-medium mb-3">Các Group hiện có</h3>
        <div id="apikey-groups-inner" class="flex flex-col gap-2 max-h-64 overflow-y-auto pr-1"></div>
      </div>
    </div>
  </div>
</div>


<div id="power-modal" class="hidden fixed inset-0 z-[9999] items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="closePowerModal()"></div>
  <div id="power-modal-box" class="relative bg-neutral-900 border border-white/10 rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden transform transition-all duration-300 scale-95 opacity-0">
    <div class="px-5 py-4 border-b border-white/8 flex items-center justify-between">
      <div>
        <h3 class="text-white font-medium text-sm" id="modal-server-name">Server</h3>
        <p class="text-neutral-500 text-xs mt-0.5" id="modal-server-id"></p>
      </div>
      <button onclick="closePowerModal()" class="text-neutral-500 hover:text-white p-1 rounded-lg hover:bg-white/10 transition">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-5 py-4 flex flex-col gap-4">
      <div>
        <p class="text-neutral-400 text-xs uppercase tracking-wider font-medium mb-2">Power Controls</p>
        <div class="flex gap-2">
          <button onclick="sendPower('start')" class="flex-1 rounded-xl bg-emerald-600/20 hover:bg-emerald-600/40 text-emerald-400 py-2.5 text-sm font-medium transition flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd"/></svg>
            Start
          </button>
          <button onclick="sendPower('restart')" class="flex-1 rounded-xl bg-yellow-600/20 hover:bg-yellow-600/40 text-yellow-400 py-2.5 text-sm font-medium transition flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M4.755 10.059a7.5 7.5 0 0 1 12.548-3.364l1.903 1.903h-3.183a.75.75 0 1 0 0 1.5h4.992a.75.75 0 0 0 .75-.75V4.356a.75.75 0 0 0-1.5 0v3.18l-1.9-1.9A9 9 0 0 0 3.306 9.67a.75.75 0 1 0 1.45.388Zm15.408 3.352a.75.75 0 0 0-.919.53 7.5 7.5 0 0 1-12.548 3.364l-1.902-1.903h3.183a.75.75 0 0 0 0-1.5H2.984a.75.75 0 0 0-.75.75v4.992a.75.75 0 0 0 1.5 0v-3.18l1.9 1.9a9 9 0 0 0 15.059-4.035.75.75 0 0 0-.53-.918Z" clip-rule="evenodd"/></svg>
            Restart
          </button>
          <button onclick="sendPower('stop')" class="flex-1 rounded-xl bg-red-600/20 hover:bg-red-600/40 text-red-400 py-2.5 text-sm font-medium transition flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z" clip-rule="evenodd"/></svg>
            Stop
          </button>
        </div>
      </div>
      <div>
        <p class="text-neutral-400 text-xs uppercase tracking-wider font-medium mb-2">Send Console Command</p>
        <div class="flex gap-2">
          <input id="modal-cmd" type="text" placeholder="say Hello World"
            class="flex-1 rounded-xl bg-white/5 border border-white/10 text-white text-sm px-3 py-2 focus:outline-none focus:border-white/30 transition placeholder:text-neutral-600"
            onkeydown="if(event.key==='Enter') sendCommand()">
          <button onclick="sendCommand()" class="rounded-xl bg-white/10 hover:bg-white/20 text-white px-3 py-2 text-sm font-medium transition">Send</button>
        </div>
      </div>
      <div id="modal-result" class="hidden rounded-xl px-3 py-2 text-xs font-mono"></div>
    </div>
  </div>
</div>

<!-- DELETE CONFIRM -->
<div id="delete-modal" class="hidden fixed inset-0 z-[9999] items-center justify-center p-4">
  <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="closeDeleteModal()"></div>
  <div id="delete-modal-box" class="relative bg-neutral-900 border border-white/10 rounded-2xl w-full max-w-sm shadow-2xl overflow-hidden transform transition-all duration-300 scale-95 opacity-0">
    <div class="px-6 py-6 text-center">
      <div class="w-12 h-12 rounded-full bg-red-500/15 flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-red-400" fill="currentColor" viewBox="0 0 256 256"><path d="M216,48H176V40a24,24,0,0,0-24-24H104A24,24,0,0,0,80,40v8H40a8,8,0,0,0,0,16h8V208a16,16,0,0,0,16,16H192a16,16,0,0,0,16-16V64h8a8,8,0,0,0,0-16ZM96,40a8,8,0,0,1,8-8h48a8,8,0,0,1,8,8v8H96ZM192,208H64V64H192ZM112,104v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Zm48,0v64a8,8,0,0,1-16,0V104a8,8,0,0,1,16,0Z"/></svg>
      </div>
      <h3 class="text-white font-semibold text-base mb-1">Delete Remote Panel?</h3>
      <p class="text-neutral-400 text-sm mb-1">Panel <span id="delete-name" class="text-white font-medium"></span> will be removed.</p>
      <p class="text-neutral-600 text-xs mb-5">Synced servers will no longer appear in Instances.</p>
      <div class="flex gap-3">
        <button onclick="closeDeleteModal()" class="flex-1 rounded-xl bg-white/10 hover:bg-white/20 text-white px-4 py-2.5 text-sm font-medium transition">Huỷ</button>
        <form id="delete-form" method="POST" class="flex-1">
          <button type="submit" class="w-full rounded-xl bg-red-600 hover:bg-red-500 text-white px-4 py-2.5 text-sm font-semibold transition">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../components/footer') %>

<script>
var _remotes = <%- JSON.stringify(remoteInstances.map(function(r){ return {id:r.id,panelUrl:r.panelUrl,panelType:r.panelType,displayName:r.displayName}; })) %>;
var _loadedServers = {};
var _currentServer = null;
var _apiKeyGroups = <%- JSON.stringify(typeof apiKeyGroups !== 'undefined' && apiKeyGroups ? apiKeyGroups : []) %>;

function openModal(boxId, overlayId) {
  var ov = document.getElementById(overlayId);
  ov.classList.remove('hidden');
  ov.classList.add('flex');
  setTimeout(function() {
    var box = document.getElementById(boxId);
    box.classList.remove('scale-95','opacity-0');
  }, 10);
}
function closeModal(boxId, overlayId) {
  var box = document.getElementById(boxId);
  box.classList.add('scale-95','opacity-0');
  setTimeout(function() {
    var ov = document.getElementById(overlayId);
    ov.classList.add('hidden');
    ov.classList.remove('flex');
  }, 250);
}
function openAddModal() {
  document.getElementById('test-result').classList.add('hidden');
  // Reset API key mode
  switchToGroupMode();
  document.getElementById('apikey-group-select').value = '';
  document.getElementById('modal-api-key-group').value = '';
  openModal('add-modal-box','add-modal');
}
function closeAddModal() { closeModal('add-modal-box','add-modal'); }
function closePowerModal() { closeModal('power-modal-box','power-modal'); _currentServer=null; }
function closeDeleteModal() { closeModal('delete-modal-box','delete-modal'); }

// API Key Group Manager
function openApiKeyManagerModal() {
  renderApiKeyGroupsList();
  openModal('apikey-manager-box','apikey-manager-modal');
}
function closeApiKeyManagerModal() { closeModal('apikey-manager-box','apikey-manager-modal'); }

function renderApiKeyGroupsList() {
  var el = document.getElementById('apikey-groups-inner');
  if (!_apiKeyGroups.length) {
    el.innerHTML = '<p class="text-neutral-500 text-sm text-center py-4">Chưa có group nào</p>';
    return;
  }
  var html = '';
  _apiKeyGroups.forEach(function(g) {
    var owner = g.ownerName || g.ownerId || '-';
    html += '<div class="flex items-center gap-3 bg-white/5 rounded-xl px-4 py-3">'
      + '<div class="flex-1 min-w-0">'
        + '<p class="text-white text-sm font-medium">' + (g.name || 'Unnamed') + '</p>'
        + '<p class="text-neutral-500 text-xs mt-0.5">Type: ' + (g.panelType || 'any') + ' | Owner: ' + owner + '</p>'
        + '<p class="text-neutral-600 text-xs font-mono truncate">' + (g.key ? g.key.slice(0,8) + '--------' : '-') + '</p>'
      + '</div>'
      + '<button onclick="deleteApiKeyGroup(\'' + g.id + '\')" class="rounded-xl bg-red-700/20 hover:bg-red-600/40 border border-red-700/20 text-red-400 px-3 py-1.5 text-xs font-medium transition shrink-0">Xoá</button>'
    + '</div>';
  });
  el.innerHTML = html;
}

function createApiKeyGroup() {
  var name = document.getElementById('newgroup-name').value.trim();
  var key = document.getElementById('newgroup-key').value.trim();
  var panelType = document.getElementById('newgroup-paneltype').value;
  var ownerId = document.getElementById('newgroup-owner').value;
  if (!name || !key) {
    window.showPopup && window.showPopup('warning', 'Thiếu thông tin', 'Vui lòng nhập tên và API key');
    return;
  }
  fetch('/remote-instances/apikey-groups/create', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({name, key, panelType, ownerId})
  }).then(function(r){return r.json();}).then(function(d) {
    if (d.success) {
      _apiKeyGroups = d.groups;
      renderApiKeyGroupsList();
      refreshApiKeyGroupSelect();
      document.getElementById('newgroup-name').value = '';
      document.getElementById('newgroup-key').value = '';
      window.showPopup && window.showPopup('success', 'Đã tạo group', name);
    } else {
      window.showPopup && window.showPopup('error', 'Lỗi', d.error || 'Failed');
    }
  }).catch(function(e) {
    window.showPopup && window.showPopup('error', 'Network error', e.message);
  });
}

function deleteApiKeyGroup(id) {
  if (!confirm('Xoá group này?')) return;
  fetch('/remote-instances/apikey-groups/delete/' + id, {method: 'DELETE'})
    .then(function(r){return r.json();}).then(function(d) {
      if (d.success) {
        _apiKeyGroups = d.groups;
        renderApiKeyGroupsList();
        refreshApiKeyGroupSelect();
        window.showPopup && window.showPopup('info', 'Đã xoá group', '');
      } else {
        window.showPopup && window.showPopup('error', 'Lỗi', d.error || 'Failed');
      }
    });
}

function refreshApiKeyGroupSelect() {
  var sel = document.getElementById('apikey-group-select');
  if (!sel) return;
  // Keep the custom option and rebuild
  var html = '<option value="" class="bg-neutral-900 text-neutral-400">- Chọn API Key group -</option>';
  _apiKeyGroups.forEach(function(g) {
    html += '<option value="' + g.key + '" data-key="' + g.key + '" class="bg-neutral-900">' + g.name + ' (' + (g.panelType || 'any') + ')</option>';
  });
  html += '<option value="__custom__" class="bg-neutral-900 text-indigo-300">Nhập thủ công (Custom)</option>';
  sel.innerHTML = html;
}

function handleApiKeyGroupSelect(val) {
  var hiddenInput = document.getElementById('modal-api-key-group');
  if (val === '__custom__') {
    switchToCustomMode();
  } else if (val) {
    hiddenInput.value = val;
  } else {
    hiddenInput.value = '';
  }
}

function switchToCustomMode() {
  document.getElementById('apikey-group-mode').classList.add('hidden');
  document.getElementById('apikey-custom-mode').classList.remove('hidden');
  document.getElementById('modal-api-key-group').name = '';
  document.getElementById('modal-api-key').name = 'apiKey';
  document.getElementById('modal-api-key').required = true;
}

function switchToGroupMode() {
  document.getElementById('apikey-group-mode').classList.remove('hidden');
  document.getElementById('apikey-custom-mode').classList.add('hidden');
  document.getElementById('modal-api-key-group').name = 'apiKey';
  if (document.getElementById('modal-api-key')) {
    document.getElementById('modal-api-key').name = '';
    document.getElementById('modal-api-key').required = false;
  }
}

function confirmDelete(id, name) {
  document.getElementById('delete-name').textContent = '"' + name + '"';
  document.getElementById('delete-form').action = '/remote-instances/delete/' + id;
  openModal('delete-modal-box','delete-modal');
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') { closeAddModal(); closePowerModal(); closeDeleteModal(); closeApiKeyManagerModal(); }
});

function toggleApiKeyVisibility() {
  var i = document.getElementById('modal-api-key');
  i.type = i.type === 'password' ? 'text' : 'password';
}

function getModalApiKey() {
  var groupMode = !document.getElementById('apikey-group-mode').classList.contains('hidden');
  if (groupMode) {
    return document.getElementById('modal-api-key-group').value;
  } else {
    return document.getElementById('modal-api-key').value;
  }
}

function testConnection() {
  var panelUrl = document.getElementById('modal-panel-url').value.trim();
  var apiKey = getModalApiKey();
  var panelType = document.getElementById('modal-panel-type').value;
  var resultEl = document.getElementById('test-result');
  var btn = document.getElementById('btn-test-conn');
  if (!panelUrl || !apiKey) {
    resultEl.textContent = 'Vui lòng nhập Panel URL và API Key trước';
    resultEl.className = 'mt-2 text-xs px-3 py-2 rounded-xl bg-yellow-900/30 text-yellow-400';
    resultEl.classList.remove('hidden'); return;
  }
  btn.disabled = true;
  btn.innerHTML = 'Dang kiem tra...';
  fetch('/remote-instances/test-connection', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({panelUrl: panelUrl.replace(/\/$/,''), apiKey, panelType})
  }).then(function(r){return r.json();}).then(function(d) {
    btn.disabled = false;
    btn.innerHTML = 'Test connection';
    if (d.online && d.tokenValid) {
      resultEl.textContent = 'OK: Kết nối OK - '+d.latency+'ms | HTTP '+d.status;
      resultEl.className = 'mt-2 text-xs px-3 py-2 rounded-xl bg-emerald-900/30 text-emerald-400';
      window.showPopup&&window.showPopup('success','Connection successful',d.latency+'ms | Token hợp lệ');
    } else if (d.online) {
      resultEl.textContent = 'WARN Online nhưng token sai - HTTP '+d.status;
      resultEl.className = 'mt-2 text-xs px-3 py-2 rounded-xl bg-yellow-900/30 text-yellow-400';
      window.showPopup&&window.showPopup('warning','Cảnh báo','Panel online nhưng token không hợp lệ');
    } else {
      resultEl.textContent = 'ERR: Không kết nối được - '+(d.error||'Timeout');
      resultEl.className = 'mt-2 text-xs px-3 py-2 rounded-xl bg-red-900/30 text-red-400';
      window.showPopup&&window.showPopup('error','Không kết nối được',d.error||'Panel offline hoặc URL sai');
    }
    resultEl.classList.remove('hidden');
  }).catch(function(e) {
    btn.disabled = false; btn.innerHTML = 'Test connection';
    resultEl.textContent = 'ERR: Lỗi: '+e.message;
    resultEl.className = 'mt-2 text-xs px-3 py-2 rounded-xl bg-red-900/30 text-red-400';
    resultEl.classList.remove('hidden');
  });
}

document.addEventListener('DOMContentLoaded', function() {
  _remotes.forEach(function(r) { pingPanel(r.id); });
  switchToGroupMode();
});

function pingPanel(remoteId) {
  var badge = document.getElementById('badge-'+remoteId);
  if (!badge) return;
  fetch('/remote-instances/ping/'+remoteId)
    .then(function(r){return r.json();})
    .then(function(d) {
      if (d.online && d.tokenValid) {
        var ms = d.latency;
        var dot, bg, txt;
        if (ms < 100) {
          dot = 'bg-green-400'; bg = 'bg-green-700/25'; txt = 'text-green-400';
        } else if (ms < 300) {
          dot = 'bg-orange-400'; bg = 'bg-orange-700/25'; txt = 'text-orange-400';
        } else {
          dot = 'bg-red-400'; bg = 'bg-red-700/25'; txt = 'text-red-400';
        }
        badge.innerHTML = '<span class="inline-block w-1.5 h-1.5 rounded-full '+dot+' mr-1"></span>'+ms+'ms';
        badge.className = 'text-xs px-2 py-0.5 rounded-full '+bg+' '+txt+' flex items-center font-medium';
      } else if (d.online) {
        badge.innerHTML = '<span class="inline-block w-1.5 h-1.5 rounded-full bg-yellow-400 mr-1"></span>Lỗi token';
        badge.className = 'text-xs px-2 py-0.5 rounded-full bg-yellow-700/25 text-yellow-400 flex items-center';
      } else {
        badge.innerHTML = '<span class="inline-block w-1.5 h-1.5 rounded-full bg-red-400 mr-1"></span>Offline';
        badge.className = 'text-xs px-2 py-0.5 rounded-full bg-red-700/25 text-red-400 flex items-center';
      }
    }).catch(function() {
      badge.innerHTML = '<span class="inline-block w-1.5 h-1.5 rounded-full bg-red-400 mr-1"></span>Offline';
      badge.className = 'text-xs px-2 py-0.5 rounded-full bg-red-700/25 text-red-400 flex items-center';
    });
}

function toggleServers(remoteId) {
  var panel = document.getElementById('servers-'+remoteId);
  var isHidden = panel.classList.contains('hidden');
  panel.classList.toggle('hidden');
  document.getElementById('btn-servers-label-'+remoteId).textContent = isHidden ? 'Hide servers' : 'View servers';
  if (isHidden && !_loadedServers[remoteId]) loadServers(remoteId);
}

function loadServers(remoteId) {
  var loadEl = document.getElementById('sl-loading-'+remoteId);
  var errEl  = document.getElementById('sl-error-'+remoteId);
  var listEl = document.getElementById('sl-list-'+remoteId);
  var cntEl  = document.getElementById('srv-count-'+remoteId);
  loadEl.classList.remove('hidden'); errEl.classList.add('hidden'); listEl.innerHTML='';
  fetch('/remote-instances/servers/'+remoteId)
    .then(function(r){return r.json();})
    .then(function(data) {
      loadEl.classList.add('hidden');
      if (data.error) {
        errEl.textContent='ERR: '+data.error; errEl.classList.remove('hidden');
        window.showPopup&&window.showPopup('error','Error loading servers',data.error); return;
      }
      var servers=data.servers||[];
      _loadedServers[remoteId]=servers;
      if (cntEl) cntEl.textContent=' | '+servers.length+' server'+(servers.length!==1?'s':'');
      renderServers(remoteId,servers);
      window.showPopup&&window.showPopup('success','Loaded','Found '+servers.length+' server(s)');
    }).catch(function(e) {
      loadEl.classList.add('hidden');
      errEl.textContent='ERR: Network error: '+e.message; errEl.classList.remove('hidden');
      window.showPopup&&window.showPopup('error','Network error',e.message);
    });
}

function fmtMem(mb) { if(!mb||mb===0) return '-'; return mb>=1024?(mb/1024).toFixed(1)+'GB':mb+'MB'; }
function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function renderServers(remoteId, servers) {
  var listEl = document.getElementById('sl-list-'+remoteId);
  if (!servers.length) {
    listEl.innerHTML='<div class="py-8 text-center"><p class="text-neutral-500 text-sm">No servers found.</p></div>'; return;
  }
  var html='<div class="rounded-xl border border-white/5 overflow-hidden divide-y divide-white/5">';
  servers.forEach(function(s) {
    var st=(s.status||'').toLowerCase();
    var running=st==='running'||st==='online';
    var offline=st==='offline'||st==='suspended'||st==='stopped';
    var sCls=running?'bg-emerald-700/20 text-emerald-400':offline?'bg-red-700/20 text-red-400':'bg-white/5 text-neutral-400';
    var dCls=running?'bg-emerald-400':offline?'bg-red-400':'bg-neutral-500';
    html+='<div class="flex items-center gap-3 px-4 py-3 hover:bg-white/[0.03] transition">'
      +'<div class="flex-1 min-w-0">'
        +'<div class="flex items-center gap-2 flex-wrap">'
          +'<span class="text-white text-sm font-medium truncate">'+esc(s.name)+'</span>'
          +'<span class="text-xs px-1.5 py-0.5 rounded-full '+sCls+' flex items-center gap-1">'
            +'<span class="w-1.5 h-1.5 rounded-full '+dCls+'"></span>'+esc(s.status||'?')
          +'</span>'
        +'</div>'
        +'<p class="text-neutral-600 text-xs mt-0.5 font-mono truncate">'+esc(s.id)
          +(s.node?' | '+esc(s.node):'')
          +' | RAM:'+fmtMem(s.limits&&s.limits.memory)
          +' CPU:'+(s.limits&&s.limits.cpu||'-')+'%'
        +'</p>'
      +'</div>'
      +'<div class="flex items-center gap-2 shrink-0">'
        +(s.localId ? '<a href="/instance/'+esc(s.localId)+'" class="rounded-xl bg-indigo-600/20 hover:bg-indigo-600/40 text-indigo-300 px-3 py-1.5 text-xs font-medium transition">Open GUI</a>' : '<span class="text-neutral-700 text-xs italic py-1.5">Not synced</span>')
        +'<button onclick="openPowerModal(\''+esc(remoteId)+'\',\''+esc(s.id)+'\',\''+esc(s.name).replace(/\'/g,"\\'")+'\')\"'
          +' class="rounded-xl bg-white/10 hover:bg-white/20 text-white px-3 py-1.5 text-xs font-medium transition">'
          +'Control'
        +'</button>'
      +'</div>'
    +'</div>';
  });
  html+='</div>';
  listEl.innerHTML=html;
}

function filterServers(remoteId) {
  var q=(document.getElementById('search-'+remoteId).value||'').toLowerCase().trim();
  var servers=_loadedServers[remoteId]||[];
  renderServers(remoteId, q?servers.filter(function(s){return s.name.toLowerCase().includes(q)||s.id.toLowerCase().includes(q)||(s.node||'').toLowerCase().includes(q);}):servers);
}

function openPowerModal(remoteId,serverId,serverName) {
  _currentServer={remoteId:remoteId,serverId:serverId};
  document.getElementById('modal-server-name').textContent=serverName;
  document.getElementById('modal-server-id').textContent=serverId;
  document.getElementById('modal-cmd').value='';
  document.getElementById('modal-result').classList.add('hidden');
  openModal('power-modal-box','power-modal');
}

function showPowerResult(msg,ok) {
  var el=document.getElementById('modal-result');
  el.textContent=msg;
  el.className='rounded-xl px-3 py-2 text-xs font-mono '+(ok?'bg-emerald-900/30 text-emerald-400':'bg-red-900/30 text-red-400');
  el.classList.remove('hidden');
}

var actionLabels={start:'Start',stop:'Stop',restart:'Restart',kill:'Force kill'};

function sendPower(action) {
  if (!_currentServer) return;
  var s=_currentServer;
  var label=actionLabels[action]||action;
  fetch('/remote-instances/power/'+s.remoteId+'/'+s.serverId,{
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({action:action})
  }).then(function(r){return r.json();}).then(function(d) {
    if (d.success) {
      showPowerResult('OK: Action sent: '+label,true);
      window.showPopup&&window.showPopup('success','Success','Action sent: '+label+' to server');
    } else {
      showPowerResult('ERR: '+(d.error||'Unknown error'),false);
      window.showPopup&&window.showPopup('error','Failed',d.error||'Could not send command');
    }
  }).catch(function(e) {
    showPowerResult('ERR: '+e.message,false);
    window.showPopup&&window.showPopup('error','Network error',e.message);
  });
}

function sendCommand() {
  if (!_currentServer) return;
  var cmd=document.getElementById('modal-cmd').value.trim();
  if (!cmd) return;
  var s=_currentServer;
  fetch('/remote-instances/command/'+s.remoteId+'/'+s.serverId,{
    method:'POST', headers:{'Content-Type':'application/json'},
    body:JSON.stringify({command:cmd})
  }).then(function(r){return r.json();}).then(function(d) {
    if (d.success) {
      showPowerResult('OK: Sent: '+cmd,true);
      document.getElementById('modal-cmd').value='';
      window.showPopup&&window.showPopup('success','Command sent',cmd);
    } else {
      showPowerResult('ERR: '+(d.error||'Lỗi'),false);
      window.showPopup&&window.showPopup('error','Send failed',d.error||'Could not send');
    }
  }).catch(function(e) {
    showPowerResult('ERR: '+e.message,false);
    window.showPopup&&window.showPopup('error','Network error',e.message);
  });
}

function syncPanel(remoteId, name) {
  var btn = document.getElementById('btn-sync-' + remoteId);
  if (btn) {
    btn.disabled = true;
    btn.innerHTML = 'Syncing...';
  }
  fetch('/remote-instances/sync/' + remoteId, { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      if (btn) { btn.disabled = false; btn.innerHTML = 'Sync'; }
      if (d.success) {
        window.showPopup && window.showPopup('success', 'Sync complete', '"' + name + '" has been synced to Instances');
      } else {
        window.showPopup && window.showPopup('error', 'Sync failed', d.error || 'Unknown error');
      }
    })
    .catch(function(e) {
      if (btn) { btn.disabled = false; btn.innerHTML = 'Sync'; }
      window.showPopup && window.showPopup('error', 'Network error', e.message);
    });
}
</script>
